# Keep these empty directories
!firmware/build
firmware/build/**
!firmware/output
firmware/output/**

# Ignore doxygen output
/docs/doxygen
/docs/can_graphs/
/docs/unit_graphs/*

# Allow per-user settings and debug states
.cache/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
/.vscode/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# MacOS
*.DS_Store

# CANpiler Autogenerated files
firmware/can_library/generated/
/superdbc/

# DearUnits Autogenerated files
firmware/common/dearunits/generated/

# FIL Autogenerated files
tests/fil/stimuli/

# cargo build artifacts
target/
/daq/daqweb/dist/

# daqapp & daqcloud runtime stores
/daq/daqapp/settings.json
/daq/daqapp/logs/
/daq/logs/
/daq/cloud_store/
/cloud_store/
/settings.json
/logs/

# Dont include venv and local dependencies
venv
.venv
.envrc
.direnv

# SQLite registry files
*.sqlite
*.sqlite-shm
*.sqlite-wal
daq/daqcloud/daqcloud.db
daq/daqcloud/daqcloud.db-shm
daq/daqcloud/daqcloud.db-wal
daq/daqcore/migrations/.diesel_lock

# Local PER26 historical test-day raw & parsed data
/PER26/
