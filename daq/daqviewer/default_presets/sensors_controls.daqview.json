{
  "id": "sensors_controls",
  "schema_version": 1,
  "name": "Sensors & Controls — IMU, GPS, Pedals & Steering",
  "description": "Sensor verification workspace replacing plot_factory/configs/sensors/*.toml: 3-axis Accelerometer, 3-axis Gyroscope, Pedal Commands, Steering Sensor, Shockpots, and GPS Sensor vs Time.",
  "custom_formulas": [],
  "layout": {
    "type": "linear",
    "dir": "horizontal",
    "shares": [0.5, 0.5],
    "children": [
      {
        "type": "linear",
        "dir": "vertical",
        "shares": [0.34, 0.33, 0.33],
        "children": [
          {
            "type": "pane",
            "widget": "scope",
            "title": "Vehicle-Axis Accelerometer vs Time",
            "x_mode": "utc_time",
            "channels": [
              { "signal_id": "IMU_acceleration.X_axis", "unit": "g" },
              { "signal_id": "IMU_acceleration.Y_axis", "unit": "g" },
              { "signal_id": "IMU_acceleration.Z_axis", "unit": "g" }
            ]
          },
          {
            "type": "pane",
            "widget": "scope",
            "title": "Vehicle-Axis Gyroscope vs Time",
            "x_mode": "utc_time",
            "channels": [
              { "signal_id": "IMU_angular_rate.X_axis", "unit": "deg/s" },
              { "signal_id": "IMU_angular_rate.Y_axis", "unit": "deg/s" },
              { "signal_id": "IMU_angular_rate.Z_axis", "unit": "deg/s" }
            ]
          },
          {
            "type": "pane",
            "widget": "scope",
            "title": "Pedal Commands vs Time",
            "x_mode": "utc_time",
            "channels": [
              { "signal_id": "pedals.throttle", "unit": "%" },
              { "signal_id": "pedals.regen", "unit": "%" },
              { "signal_id": "pedals.brake", "unit": "%" }
            ]
          }
        ]
      },
      {
        "type": "linear",
        "dir": "vertical",
        "shares": [0.34, 0.33, 0.33],
        "children": [
          {
            "type": "pane",
            "widget": "scope",
            "title": "Steering Sensor vs Time",
            "x_mode": "utc_time",
            "channels": [
              { "signal_id": "LWS_Standard.LWS_ANGLE", "unit": "deg" },
              { "signal_id": "LWS_Standard.LWS_SPEED", "unit": "deg/s" }
            ]
          },
          {
            "type": "pane",
            "widget": "scope",
            "title": "GPS Sensor vs Time",
            "x_mode": "utc_time",
            "channels": [
              { "signal_id": "gps_speed_heading.gps_speed", "unit": "m/s" },
              { "signal_id": "gps_speed_heading.gps_heading", "unit": "deg" },
              { "signal_id": "gps_velocity.gps_vel_e", "unit": "m/s" },
              { "signal_id": "gps_velocity.gps_vel_n", "unit": "m/s" },
              { "signal_id": "gps_coordinates.latitude", "unit": "deg" },
              { "signal_id": "gps_coordinates.longitude", "unit": "deg" }
            ]
          },
          {
            "type": "pane",
            "widget": "scope",
            "title": "Shockpot Displacements vs Time",
            "x_mode": "utc_time",
            "channels": [
              { "signal_id": "front_shockpots.left", "unit": "mm" },
              { "signal_id": "front_shockpots.right", "unit": "mm" },
              { "signal_id": "rear_shockpots.left", "unit": "mm" },
              { "signal_id": "rear_shockpots.right", "unit": "mm" }
            ]
          }
        ]
      }
    ]
  }
}
