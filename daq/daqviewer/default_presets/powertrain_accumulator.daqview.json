{
  "id": "powertrain_accumulator",
  "schema_version": 1,
  "name": "Powertrain — Accumulator, Torque & Motor Speeds",
  "description": "Powertrain and HV accumulator workspace replacing plot_factory/configs/powertrain/*.toml: Battery Power & Current, Motor Speeds, Requested vs Actual Torque, and Power vs Voltage scatters.",
  "custom_formulas": [],
  "layout": {
    "type": "linear",
    "dir": "horizontal",
    "shares": [0.6, 0.4],
    "children": [
      {
        "type": "linear",
        "dir": "vertical",
        "shares": [0.5, 0.5],
        "children": [
          {
            "type": "pane",
            "widget": "scope",
            "title": "Battery Power and Current",
            "x_mode": "utc_time",
            "channels": [
              { "signal_id": "battery.power_w" },
              { "signal_id": "pack_stats.pack_current" },
              { "signal_id": "battery.voltage_v" },
              { "signal_id": "pack_stats.pack_voltage" },
              { "signal_id": "battery.energy_wh" }
            ]
          },
          {
            "type": "tabs",
            "active": 0,
            "children": [
              {
                "type": "pane",
                "widget": "scope",
                "title": "Requested and Actual Torque",
                "x_mode": "utc_time",
                "channels": [
                  { "signal_id": "vcu_torque_request.front_left" },
                  { "signal_id": "vcu_torque_request.front_right" },
                  { "signal_id": "vcu_torque_request.rear_left" },
                  { "signal_id": "vcu_torque_request.rear_right" },
                  { "signal_id": "INVA_CRIT.AMK_ActualTorque" },
                  { "signal_id": "INVB_CRIT.AMK_ActualTorque" },
                  { "signal_id": "INVC_CRIT.AMK_ActualTorque" },
                  { "signal_id": "INVD_CRIT.AMK_ActualTorque" }
                ]
              },
              {
                "type": "pane",
                "widget": "scope",
                "title": "Throttle and AMK Actual Torque vs Time",
                "x_mode": "utc_time",
                "channels": [
                  { "signal_id": "pedals.throttle" },
                  { "signal_id": "INVA_CRIT.AMK_ActualTorque" },
                  { "signal_id": "INVB_CRIT.AMK_ActualTorque" },
                  { "signal_id": "INVC_CRIT.AMK_ActualTorque" },
                  { "signal_id": "INVD_CRIT.AMK_ActualTorque" }
                ]
              },
              {
                "type": "pane",
                "widget": "scope",
                "title": "Wheel / Motor Speeds",
                "x_mode": "utc_time",
                "channels": [
                  { "signal_id": "wheel_speeds.front_left" },
                  { "signal_id": "wheel_speeds.front_right" },
                  { "signal_id": "wheel_speeds.rear_left" },
                  { "signal_id": "wheel_speeds.rear_right" }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "linear",
        "dir": "vertical",
        "shares": [0.5, 0.5],
        "children": [
          {
            "type": "pane",
            "widget": "xy_scatter",
            "title": "Total Battery Power vs Battery Voltage",
            "x_signal": "battery.voltage_v",
            "y_signal": "battery.power_w",
            "z_color_signal": "battery.energy_wh",
            "equal_aspect": false,
            "show_g_rings": false
          },
          {
            "type": "tabs",
            "active": 0,
            "children": [
              {
                "type": "pane",
                "widget": "xy_scatter",
                "title": "AMK Actual Torque vs Speed",
                "x_signal": "INVC_CRIT.AMK_ActualSpeed",
                "y_signal": "INVC_CRIT.AMK_ActualTorque",
                "z_color_signal": "battery.power_kw",
                "equal_aspect": false,
                "show_g_rings": false
              },
              {
                "type": "pane",
                "widget": "xy_scatter",
                "title": "Requested vs Actual Torque",
                "x_signal": "INVC_SET.AMK_TorqueSetpoint",
                "y_signal": "INVC_CRIT.AMK_ActualTorque",
                "z_color_signal": "battery.power_kw",
                "equal_aspect": false,
                "show_g_rings": false
              }
            ]
          }
        ]
      }
    ]
  }
}
