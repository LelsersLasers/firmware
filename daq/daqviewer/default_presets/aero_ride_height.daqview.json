{
  "id": "aero_ride_height",
  "schema_version": 1,
  "name": "Aerodynamics — Heave, Roll, Pitch & Ride Height",
  "description": "Aerodynamics and suspension ride-height analysis across speed and track distance: front/rear heave, roll displacement, damper velocities, and shockpot deflections.",
  "custom_formulas": [],
  "layout": {
    "type": "linear",
    "dir": "horizontal",
    "shares": [0.6, 0.4],
    "children": [
      {
        "type": "linear",
        "dir": "vertical",
        "shares": [0.5, 0.5],
        "children": [
          {
            "type": "tabs",
            "active": 0,
            "children": [
              {
                "type": "pane",
                "widget": "xy_scatter",
                "title": "Front Shockpot vs Ground Speed",
                "x_signal": "gps_speed_heading.gps_speed",
                "y_signal": "front_shockpots.left",
                "z_color_signal": "rear_shockpots.left",
                "equal_aspect": false,
                "show_g_rings": false
              },
              {
                "type": "pane",
                "widget": "xy_scatter",
                "title": "Rear Shockpot vs Ground Speed",
                "x_signal": "gps_speed_heading.gps_speed",
                "y_signal": "rear_shockpots.left",
                "z_color_signal": "front_shockpots.left",
                "equal_aspect": false,
                "show_g_rings": false
              }
            ]
          },
          {
            "type": "pane",
            "widget": "scope",
            "title": "Shockpot Displacements vs Time",
            "x_mode": "utc_time",
            "channels": [
              { "signal_id": "front_shockpots.left" },
              { "signal_id": "front_shockpots.right" },
              { "signal_id": "rear_shockpots.left" },
              { "signal_id": "rear_shockpots.right" }
            ]
          }
        ]
      },
      {
        "type": "linear",
        "dir": "vertical",
        "shares": [0.5, 0.5],
        "children": [
          {
            "type": "pane",
            "widget": "scope",
            "title": "Roll Displacement & Speed vs Distance",
            "x_mode": "track_distance",
            "speed_signal_id": "gps_speed_heading.gps_speed",
            "channels": [
              { "signal_id": "vd.front_roll_displacement_mm" },
              { "signal_id": "vd.rear_roll_displacement_mm" },
              { "signal_id": "gps_speed_heading.gps_speed" }
            ]
          },
          {
            "type": "pane",
            "widget": "gps_plot",
            "title": "GPS Track Colored by Speed",
            "color_signal": "gps_speed_heading.gps_speed",
            "max_distance_meters": 500.0
          }
        ]
      }
    ]
  }
}
